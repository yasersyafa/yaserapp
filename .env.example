# Web3Forms access key — powers the contact form (src/pages/contact.astro).
# Get one free at https://web3forms.com by entering the destination inbox.
# Public by design: it only authorizes sending mail to the address it's bound to.
# Must also be set in the Cloudflare Pages dashboard (Settings → Environment variables)
# for Production + Preview, or the built form ships with an empty key.
PUBLIC_WEB3FORMS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
