---
interface Props {
  href: string;
  title: string;
  type: string;
  year: number;
  engine?: string;
  hero: string;
  heroAlt: string;
  featured?: boolean;
}

const { href, title, type, year, engine, hero, heroAlt, featured } = Astro.props;
---

<a href={href} class="card block group">
  <div class="card-media">
    <img src={hero} alt={heroAlt} loading="lazy" />
  </div>
  <div class="p-4 sm:p-5 flex flex-col gap-2">
    <p class="mono text-[10px] sm:text-xs text-(--muted) uppercase tracking-widest flex items-center gap-2 flex-wrap">
      <span>{type}{engine && <> · {engine}</>}</span>
      <span class="opacity-60">·</span>
      <span>{year}</span>
      {featured && <span class="ml-auto text-(--accent)">★ featured</span>}
    </p>
    <h3 class="display text-2xl sm:text-3xl group-hover:text-(--accent) transition-colors duration-300">{title}</h3>
  </div>
</a>
