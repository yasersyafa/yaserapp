---
interface Props {
  letter: 'S' | 'T' | 'A' | 'R';
  label: string;
  body: string;
  points?: string[];
  accent?: boolean;
  last?: boolean;
}
const { letter, label, body, points = [], accent = false, last = false } = Astro.props;
---

<section class="grid grid-cols-[3rem_1fr] sm:grid-cols-[7rem_1fr] gap-4 sm:gap-8 items-start reveal">
  <div class="relative">
    <span
      class:list={[
        'display block text-5xl sm:text-7xl leading-none',
        accent ? 'text-(--accent)' : 'text-(--fg)',
      ]}
    >{letter}</span>
    {!last && (
      <span aria-hidden="true" class="absolute left-1/2 -translate-x-1/2 top-14 sm:top-20 bottom-0 w-px bg-(--line) -mb-8 sm:-mb-12"></span>
    )}
  </div>
  <div class="pb-8 sm:pb-12">
    <p class="mono text-[10px] sm:text-xs uppercase tracking-[0.3em] text-(--muted)">{label}</p>
    <p class="mt-3 text-base sm:text-lg max-w-2xl">{body}</p>
    {points.length > 0 && (
      <ul class="mt-4 space-y-1.5 text-(--muted) text-sm sm:text-base list-disc list-outside ml-4 marker:text-(--accent) max-w-2xl">
        {points.map((p) => <li>{p}</li>)}
      </ul>
    )}
    <slot />
  </div>
</section>
