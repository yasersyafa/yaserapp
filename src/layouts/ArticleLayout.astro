---
import BaseLayout from './BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { site } from '../site.config';

interface NavLink {
  id: string;
  title: string;
}

interface Props {
  title: string;
  dek: string;
  date: Date;
  updated?: Date;
  tags: string[];
  readingTime?: number;
  slug: string;
  prev?: NavLink | null;
  next?: NavLink | null;
}

const { title, dek, date, updated, tags, readingTime, slug, prev, next } = Astro.props;

const dateStr = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const dateIso = date.toISOString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: dek,
  datePublished: dateIso,
  dateModified: updated ? updated.toISOString() : dateIso,
  author: { '@type': 'Person', name: site.author.name, url: site.url },
  keywords: tags.join(', '),
  mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(`/blog/${slug}/`, site.url).toString() },
};
---

<BaseLayout title={title} description={dek} current="Devlog">
  <JsonLd slot="head" data={jsonLd} />

  <article class="max-w-4xl mx-auto px-5 sm:px-6 pt-12 sm:pt-16 pb-16 sm:pb-20">
    <a href="/blog/" class="link mono text-sm text-(--muted)">← devlog</a>

    <header class="mt-8 sm:mt-10">
      <p class="mono text-[10px] sm:text-xs uppercase tracking-[0.3em] text-(--muted) reveal flex flex-wrap gap-x-2">
        <time datetime={dateIso}>{dateStr}</time>
        {readingTime && <span>· {readingTime} min</span>}
        {tags.length > 0 && <span>· {tags.map((t) => `#${t}`).join(' ')}</span>}
      </p>
      <h1 class="display text-pretty text-4xl sm:text-7xl mt-4 max-w-3xl reveal" transition:name="page-title">{title}</h1>
      <p class="text-lg text-pretty sm:text-2xl italic mt-5 sm:mt-6 max-w-2xl text-(--muted) reveal">{dek}</p>
    </header>

    <hr class="rule mt-8 sm:mt-12" />

    <div class="grid grid-cols-1 lg:grid-cols-[12rem_minmax(0,1fr)] gap-8 sm:gap-10 mt-8 sm:mt-10">
      <aside class="lg:sticky lg:top-24 lg:self-start mono text-sm">
        <p class="uppercase tracking-widest text-(--muted) mb-3">On this page</p>
        <nav id="toc" class="flex text-pretty flex-col gap-2"></nav>
      </aside>
      <div class="prose-pixel min-w-0 text-pretty max-w-none [&_h2]:display [&_h2]:text-3xl [&_h2]:mt-14 [&_h2]:mb-4 [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:mt-8 [&_h3]:mb-3 [&_p]:my-5 [&_pre]:bg-(--fg) [&_pre]:text-(--bg) [&_pre]:p-5 [&_pre]:rounded-xl [&_pre]:overflow-x-auto [&_pre]:my-6 [&_code]:font-mono [&_table]:my-6 [&_th]:text-left [&_th]:border-b [&_th]:border-(--line) [&_th]:p-3 [&_td]:p-3 [&_td]:border-b [&_td]:border-(--line) [&_img]:my-8 [&_img]:rounded-xl [&_a]:link [&_a]:text-(--fg)">
        <slot />
      </div>
    </div>

    {(prev || next) && (
      <nav class="mt-16 sm:mt-20 pt-8 border-t-2 border-(--fg) grid grid-cols-1 sm:grid-cols-2 gap-5">
        {prev ? (
          <a href={`/blog/${prev.id}/`} class="group brut brut-hover p-5">
            <div class="mono text-[10px] uppercase tracking-[0.2em] text-(--muted)">← previous</div>
            <div class="mt-2 text-pretty text-(--fg) group-hover:text-(--accent) transition-colors">{prev.title}</div>
          </a>
        ) : <div class="hidden sm:block" />}
        {next ? (
          <a href={`/blog/${next.id}/`} class="group brut brut-hover p-5 text-right">
            <div class="mono text-[10px] uppercase tracking-[0.2em] text-(--muted)">next →</div>
            <div class="mt-2 text-pretty text-(--fg) group-hover:text-(--accent) transition-colors">{next.title}</div>
          </a>
        ) : <div class="hidden sm:block" />}
      </nav>
    )}
  </article>

  <button
    type="button"
    id="back-to-top"
    aria-label="Back to top"
    class="magnet fixed bottom-6 right-6 z-40 w-11 h-11 rounded-full border border-(--line) bg-(--bg) text-(--fg) flex items-center justify-center mono text-sm shadow-sm opacity-0 pointer-events-none translate-y-2 transition-all duration-300 hover:border-(--accent) hover:text-(--accent)"
    data-magnet="0.2"
  >
    ↑
  </button>

  <style>
    #toc a {
      position: relative;
      transition: color 0.2s ease, padding-left 0.2s ease;
      color: var(--muted);
    }
    #toc a::before {
      content: '';
      position: absolute;
      left: -0.75rem;
      top: 50%;
      width: 0.25rem;
      height: 0.25rem;
      border-radius: 9999px;
      background: var(--muted);
      transform: translateY(-50%) scale(0);
      transition: transform 0.2s ease, background 0.2s ease;
    }
    #toc a.is-active {
      color: var(--fg);
    }
    #toc a.is-active::before {
      transform: translateY(-50%) scale(1);
      background: var(--accent);
    }
    #toc a.toc-h3 {
      padding-left: 1rem;
      font-size: 0.85em;
    }
    #back-to-top.is-visible {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }
  </style>

  <script>
    function buildToc() {
      const headings = document.querySelectorAll<HTMLElement>('article h2[id], article h3[id]');
      const toc = document.getElementById('toc');
      if (!toc) return;
      toc.innerHTML = '';
      const links: HTMLAnchorElement[] = [];
      headings.forEach((h) => {
        const a = document.createElement('a');
        a.href = `#${h.id}`;
        a.textContent = h.textContent;
        a.className = h.tagName === 'H3' ? 'toc-h3 link' : 'link';
        a.dataset.target = h.id;
        a.addEventListener('click', (e) => {
          e.preventDefault();
          const target = document.getElementById(h.id);
          if (target) {
            const top = target.getBoundingClientRect().top + window.scrollY - 80;
            window.scrollTo({ top, behavior: 'smooth' });
            history.replaceState(null, '', `#${h.id}`);
          }
        });
        toc.appendChild(a);
        links.push(a);
      });

      const byId = new Map<string, HTMLAnchorElement>();
      links.forEach((l) => byId.set(l.dataset.target!, l));

      const visible = new Set<string>();
      const setActive = (id: string | null) => {
        links.forEach((l) => l.classList.toggle('is-active', l.dataset.target === id));
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            const id = e.target.id;
            if (e.isIntersecting) visible.add(id);
            else visible.delete(id);
          });
          if (visible.size === 0) return;
          let firstId: string | null = null;
          headings.forEach((h) => {
            if (!firstId && visible.has(h.id)) firstId = h.id;
          });
          setActive(firstId);
        },
        { rootMargin: '-80px 0px -65% 0px', threshold: 0 }
      );
      headings.forEach((h) => observer.observe(h));

      const stored = (window as any).__tocObserver;
      if (stored) stored.disconnect();
      (window as any).__tocObserver = observer;
    }

    function setupBackToTop() {
      const btn = document.getElementById('back-to-top');
      if (!btn) return;
      const onScroll = () => {
        btn.classList.toggle('is-visible', window.scrollY > 480);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      btn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
      const stored = (window as any).__btnScroll;
      if (stored) window.removeEventListener('scroll', stored);
      (window as any).__btnScroll = onScroll;
    }

    function init() {
      buildToc();
      setupBackToTop();
    }

    init();
    document.addEventListener('astro:after-swap', init);
  </script>
</BaseLayout>
