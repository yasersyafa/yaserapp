---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';

const projects = await getCollection('project');
const posts = await getCollection('blog', ({ data }) => !data.draft);

const counts = {
  years: 5,
  projects: projects.length,
  jams: projects.filter((p) => p.data.type === 'jam').length,
  posts: posts.length,
};

const skills = [
  { label: 'Gameplay programming', level: 4 },
  { label: 'Frontend', level: 5 },
  { label: 'Backend', level: 5 },
  { label: 'Tooling & pipelines', level: 4 },
  { label: 'Game design', level: 3 },
  { label: 'Systems architecture', level: 4 },
];

const stack = [
  { label: '', items: ['Unity', 'Godot', 'Phaser', 'Astro', 'Next', 'Hono', 'C#', 'Lua', 'TypeScript', 'Java', 'React', 'Vue'], accent: 'from-(--accent)/20 to-transparent' },
];

const dailyTools = [
  { label: 'Editor', value: 'VS Code · Claude Code' },
  { label: 'Terminal', value: 'zsh' },
  { label: 'OS', value: 'macOS' },
  { label: 'Notes', value: 'Notion · Google Docs' },
  { label: 'Design', value: 'Figma · Excalidraw' },
  { label: 'Versioning', value: 'git' },
];

const experience = [
  {
    role: 'Game porting programmer & Fullstack programmer',
    org: 'HAGE Games',
    period: '2023 — now',
    bullets: [
      'Port mobile/desktop game to Web games',
      'Built fullstack web https://hagegames.com and https://next-hagebook.vercel.app',
      'Implement SDK for publishing to web game platforms.',
      'Built custom WebGL Template, a custom loading screen for HAGE Games products.',
      'Writing the public devlog as a working notebook.',
    ],
  },
  {
    role: 'Game programming intern',
    org: 'Gamechanger Studio',
    period: '2025 - 2026',
    bullets: [
      'Minigame scripting in Unity for a desktop game.',
      'First experience in localizations and addressable library.',
    ],
  },
  {
    role: 'Webmaster',
    org: 'EEPIS News and Network Team',
    period: '2023 — 2024',
    bullets: [
      'Head of EEPIS News and Network Team: coordinate to all division in organizations',
      'Built frontend https://ent.pens.ac.id using React Typescript.',
      'Built frontend https://media.ent.pens.ac.id using Vue.js',
    ],
  }
];

const education = [
  {
    school: 'Politeknik Elektronika Negeri Surabaya — SBY',
    program: 'Game Technology',
    period: '2023 — 2027',
    detail: 'Focus on game development while joining to Webmaster team.',
  },
  {
    school: 'SMK Negeri 1 Jakarta — JKT',
    program: 'Software Engineering',
    period: '2020 - 2023',
    detail: 'Focus on web development, both in frontend and backend',
  },
];

const currently = [
  { label: 'Building', value: 'Bloom & Place' },
  { label: 'Reading', value: 'Ego is The Enemy' },
  { label: 'Listening', value: 'The Goo Goo Dolls · Black Balloons' },
];

const principles = [
  'Work',
  'Life',
  'Balance',
];
---

<BaseLayout title="About" description={`About ${site.author.name}.`} current="About">
  <section class="max-w-5xl mx-auto px-5 sm:px-6 pt-16 sm:pt-24 pb-10">
    <p class="mono text-[10px] sm:text-xs uppercase tracking-[0.3em] text-(--muted) reveal">Who I am</p>
    <h1 class="display text-[clamp(3rem,12vw,9rem)] mt-4 reveal" transition:name="page-title">About.</h1>

    <div class="mt-6 sm:mt-8 flex flex-wrap items-center gap-3 sm:gap-5 mono text-xs sm:text-sm text-(--muted) reveal">
      <span class="inline-flex items-center gap-2">
        <span class="relative inline-flex w-2 h-2">
          <span class="absolute inset-0 rounded-full bg-(--accent) opacity-75 motion-safe:animate-ping"></span>
          <span class="relative w-2 h-2 rounded-full bg-(--accent)"></span>
        </span>
        open to collab
      </span>
      <span class="opacity-50">·</span>
      <span>{site.author.location}</span>
      <span class="opacity-50">·</span>
      <span>game dev / software engineer</span>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-5 sm:px-6 pb-16">
    <div class="grid grid-cols-1 md:grid-cols-[1fr_2fr] gap-8 sm:gap-12 items-start">
      <div class="reveal">
        <div class="aspect-square rounded-2xl border border-(--line) overflow-hidden bg-linear-to-br from-(--accent)/15 to-(--secondary)/10">
          <img
            src="/sprites/profile.jpg"
            alt={`Portrait of ${site.author.name}`}
            class="w-full h-full object-cover"
            width="600"
            height="600"
            loading="eager"
          />
        </div>
        <p class="mono text-[10px] uppercase tracking-widest text-(--muted) mt-3">— {site.author.name}</p>
      </div>
      <div class="prose-pixel text-justify text-pretty max-w-2xl text-base sm:text-lg [&_p]:my-5 [&_a]:link [&_a]:text-(--fg) reveal">
        <p>I am Muhammad Yaser Syafa Al-Machdi, a <strong class="text-(--fg)">final year Game Technology student</strong> passionate about creating games and web applications. I have joined various competitions, including game development contests, campus website competitions, and game jams, where I sharpened my skills in teamwork, problem-solving, and rapid prototyping.</p>
        <p>I write the <a href="/blog/">devlog</a> as a working notebook. If something here is useful to you, <a href="/contact/">send me a note</a>.</p>
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-5 sm:px-6 py-12 sm:py-16 border-y border-(--line)">
    <dl class="grid grid-cols-2 md:grid-cols-4 gap-x-4 gap-y-8 stagger">
      <div>
        <dt class="mono text-[10px] uppercase tracking-widest text-(--muted)">Years</dt>
        <dd class="display text-5xl sm:text-7xl mt-2"><span data-count={counts.years} data-count-suffix="+">0+</span></dd>
      </div>
      <div>
        <dt class="mono text-[10px] uppercase tracking-widest text-(--muted)">Projects</dt>
        <dd class="display text-5xl sm:text-7xl mt-2 text-(--accent)"><span data-count={counts.projects}>0</span></dd>
      </div>
      <div>
        <dt class="mono text-[10px] uppercase tracking-widest text-(--muted)">Jams</dt>
        <dd class="display text-5xl sm:text-7xl mt-2"><span data-count={counts.jams}>0</span></dd>
      </div>
      <div>
        <dt class="mono text-[10px] uppercase tracking-widest text-(--muted)">Posts</dt>
        <dd class="display text-5xl sm:text-7xl mt-2 text-(--secondary)"><span data-count={counts.posts}>0</span></dd>
      </div>
    </dl>
  </section>

  <section class="max-w-5xl mx-auto px-5 sm:px-6 mt-16 sm:mt-24">
    <header class="flex items-end justify-between mb-6 sm:mb-10 reveal">
      <h2 class="display text-3xl sm:text-5xl">Skills</h2>
      <p class="mono text-xs text-(--muted) hidden sm:block">what I'm good at</p>
    </header>
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-5 stagger">
      {skills.map((s) => (
        <li class="flex items-center justify-between gap-4 py-2 border-b border-(--line)">
          <span class="text-base sm:text-lg">{s.label}</span>
          <span class="flex gap-1.5 shrink-0" aria-label={`${s.level} of 5`}>
            {Array.from({ length: 5 }).map((_, i) => (
              <span class={`w-2 h-2 rounded-full ${i < s.level ? 'bg-(--fg)' : 'bg-(--line)'}`}></span>
            ))}
          </span>
        </li>
      ))}
    </ul>
  </section>

  <section class="max-w-5xl mx-auto px-5 sm:px-6 mt-16 sm:mt-24">
    <header class="flex items-end justify-between mb-6 sm:mb-10 reveal">
      <h2 class="display text-3xl sm:text-5xl">Stack</h2>
      <p class="mono text-xs text-(--muted) hidden sm:block">tools I reach for</p>
    </header>
    <div class="grid grid-cols-1 gap-4 sm:gap-6 stagger">
      {stack.map((s) => (
        <div class={`tilt rounded-2xl border border-(--line) p-5 sm:p-6 bg-linear-to-br ${s.accent} group transition-colors hover:border-(--fg)`} data-tilt="4">
          <p class="mono text-[10px] uppercase tracking-widest text-(--muted) mb-3">{s.label}</p>
          <ul class="flex justify-center flex-wrap gap-2">
            {s.items.map((it) => (
              <li class="chip group-hover:border-(--fg) group-hover:text-(--fg) transition-colors">{it}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-5 sm:px-6 mt-16 sm:mt-24">
    <header class="flex items-end justify-between mb-6 sm:mb-10 reveal">
      <h2 class="display text-3xl sm:text-5xl">Daily tools</h2>
      <p class="mono text-xs text-(--muted) hidden sm:block">what's open right now</p>
    </header>
    <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 stagger">
      {dailyTools.map((t) => (
        <div class="rounded-xl border border-(--line) p-4 sm:p-5 hover:border-(--fg) transition-colors">
          <dt class="mono text-[10px] uppercase tracking-widest text-(--muted)">{t.label}</dt>
          <dd class="mt-2 text-base sm:text-lg">{t.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="max-w-5xl mx-auto px-5 sm:px-6 mt-16 sm:mt-24">
    <header class="flex items-end justify-between mb-8 sm:mb-12 reveal">
      <h2 class="display text-3xl sm:text-5xl">Experience</h2>
      <p class="mono text-xs text-(--muted) hidden sm:block">where I've worked</p>
    </header>
    <ol class="relative">
      <span aria-hidden="true" class="absolute left-3 sm:left-4 top-2 bottom-2 w-px bg-(--line)"></span>
      <div class="stagger space-y-10 sm:space-y-12">
        {experience.map((e) => (
          <li class="relative pl-10 sm:pl-14">
            <span class="absolute left-1.5 sm:left-2.5 top-2 w-3 h-3 rounded-full bg-(--accent) ring-4 ring-(--bg)"></span>
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <p class="display text-2xl sm:text-3xl">{e.role}</p>
              <span class="mono text-xs text-(--muted)">@ {e.org}</span>
            </div>
            <p class="mono text-[10px] uppercase tracking-widest text-(--muted) mt-1">{e.period}</p>
            <ul class="mt-3 space-y-1.5 text-(--muted) max-w-2xl text-sm sm:text-base list-disc list-outside ml-4 marker:text-(--accent)">
              {e.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </li>
        ))}
      </div>
    </ol>
  </section>

  <section class="max-w-5xl mx-auto px-5 sm:px-6 mt-16 sm:mt-24">
    <header class="flex items-end justify-between mb-6 sm:mb-10 reveal">
      <h2 class="display text-3xl sm:text-5xl">Education</h2>
      <p class="mono text-xs text-(--muted) hidden sm:block">where I learned</p>
    </header>
    <div class="grid grid-cols-1 stagger gap-4 sm:gap-6">
      {education.map((e) => (
        <div class="rounded-2xl border border-(--line) p-5 sm:p-6 hover:border-(--fg) transition-colors">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <p class="display text-xl sm:text-2xl">{e.school}</p>
            <span class="mono text-xs text-(--muted)">· {e.period}</span>
          </div>
          <p class="mt-1 text-base">{e.program}</p>
          {e.detail && <p class="mt-2 text-(--muted) text-sm sm:text-base max-w-2xl">{e.detail}</p>}
        </div>
      ))}
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-5 sm:px-6 mt-16 sm:mt-24">
    <header class="flex items-end justify-between mb-6 sm:mb-10 reveal">
      <h2 class="display text-3xl sm:text-5xl">Currently</h2>
      <p class="mono text-xs text-(--muted) hidden sm:block">snapshot</p>
    </header>
    <ul class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6 stagger">
      {currently.map((c) => (
        <li class="rounded-2xl border border-(--line) p-5 hover:border-(--fg) transition-colors">
          <p class="mono text-[10px] uppercase tracking-widest text-(--muted)">{c.label}</p>
          <p class="display text-xl mt-2">{c.value}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="max-w-5xl mx-auto px-5 sm:px-6 mt-16 sm:mt-24">
    <header class="mb-6 sm:mb-10 reveal">
      <h2 class="display text-3xl sm:text-5xl">How I work</h2>
    </header>
    <ul class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6 stagger">
      {principles.map((p, i) => (
        <li class="rounded-2xl border border-(--line) p-5 sm:p-6 hover:border-(--fg) transition-colors">
          <span class="mono text-xs text-(--accent)">0{i + 1}</span>
          <p class="display text-xl sm:text-2xl mt-3 leading-snug">{p}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="max-w-5xl mx-auto px-5 sm:px-6 mt-20 sm:mt-32 mb-16 sm:mb-24">
    <div class="rounded-3xl border border-(--line) p-8 sm:p-14 bg-linear-to-br from-(--accent)/10 to-transparent text-center reveal">
      <p class="mono text-[10px] sm:text-xs uppercase tracking-[0.3em] text-(--muted)">Get in touch</p>
      <p class="display text-3xl sm:text-5xl mt-4 max-w-2xl mx-auto">
        Got an idea, a jam team, or a tool that needs building?
      </p>
      <div class="mt-8 flex flex-wrap gap-3 justify-center">
        <a href="/contact/" class="btn btn-primary magnet" data-magnet="0.2">say hi →</a>
        <a href="/projects/" class="btn magnet" data-magnet="0.2">see work</a>
      </div>
    </div>
  </section>
</BaseLayout>
