---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const tags = Array.from(new Set(posts.flatMap((p) => p.data.tags))).sort();
---

<BaseLayout title="Devlog" description="Notes on games, code, and shipping." current="Devlog">
  <section class="max-w-4xl mx-auto px-5 sm:px-6 pt-16 sm:pt-20 pb-10 sm:pb-12">
    <p class="mono text-[10px] sm:text-xs uppercase tracking-[0.3em] text-(--muted) reveal">Working notebook</p>
    <h1 class="display text-5xl sm:text-7xl mt-4 reveal" transition:name="page-title">Devlog</h1>
    <p class="text-lg sm:text-xl mt-5 sm:mt-6 max-w-2xl text-(--muted) reveal">
      Notes on games, code, and shipping.
    </p>
  </section>

  <section class="max-w-4xl mx-auto px-5 sm:px-6">
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-8 sm:mb-10 reveal">
        {tags.map((t) => (
          <a href={`/blog/tag/${t}/`} class="chip">#{t}</a>
        ))}
      </div>
    )}

    <ul class="divide-y-2 divide-(--fg) stagger">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`} class="block py-6 sm:py-8 group">
            <p class="mono text-[10px] sm:text-xs uppercase tracking-widest text-(--muted)">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </time>
              {post.data.readingTime && <> · {post.data.readingTime} min</>}
              {post.data.tags.length > 0 && <> · {post.data.tags.map((t) => `#${t}`).join(' ')}</>}
            </p>
            <h2 class="display text-2xl text-pretty sm:text-4xl mt-2 group-hover:text-(--accent) transition-colors duration-300">
              {post.data.title}
            </h2>
            <p class="mt-2 sm:mt-3 text-pretty max-w-2xl text-(--muted) text-sm sm:text-base">{post.data.dek}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
