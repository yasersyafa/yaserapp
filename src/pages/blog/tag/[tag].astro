---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = Array.from(new Set(posts.flatMap((p) => p.data.tags)));
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`Devlog posts tagged #${tag}.`} current="Devlog">
  <section class="max-w-4xl mx-auto px-5 sm:px-6 pt-16 sm:pt-20 pb-10 sm:pb-12">
    <a href="/blog/" class="link mono text-sm text-[var(--muted)]">← devlog</a>
    <h1 class="display text-5xl sm:text-7xl mt-6 reveal break-all" transition:name="page-title">#{tag}</h1>
    <p class="mono text-sm mt-3 text-[var(--muted)] reveal">{posts.length} post{posts.length === 1 ? '' : 's'}</p>
  </section>

  <section class="max-w-4xl mx-auto px-5 sm:px-6 pb-16">
    <ul class="divide-y divide-[var(--line)] stagger">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`} class="block py-6 sm:py-8 group">
            <p class="mono text-[10px] sm:text-xs uppercase tracking-widest text-[var(--muted)]">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </time>
              {post.data.readingTime && <> · {post.data.readingTime} min</>}
            </p>
            <h2 class="display text-2xl sm:text-3xl mt-2 group-hover:text-[var(--accent)] transition-colors duration-300">
              {post.data.title}
            </h2>
            <p class="mt-2 text-[var(--muted)] text-sm sm:text-base">{post.data.dek}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
