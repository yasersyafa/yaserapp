---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
---

<BaseLayout title="Contact" description="Get in touch." current="Contact">
  <section class="max-w-3xl mx-auto px-5 sm:px-6 pt-16 sm:pt-20 pb-16">
    <p class="mono text-[10px] sm:text-xs uppercase tracking-[0.3em] text-(--muted) reveal">Say hi</p>
    <h1 class="display text-5xl sm:text-7xl mt-4 reveal" transition:name="page-title">Contact</h1>

    <div class="mt-10 sm:mt-12 reveal brut p-6 sm:p-8 bg-linear-to-br from-(--accent)/15 to-transparent">
      <p class="mono text-[10px] uppercase tracking-[0.3em] text-(--muted) mb-3">Email</p>
      <a
        href={`mailto:${site.author.email}`}
        class="display text-[clamp(0.95rem,4.6vw,2rem)] link inline-block magnet whitespace-nowrap"
        data-magnet="0.15"
      >
        {site.author.email}
      </a>
      <div class="mt-4 flex items-center gap-3">
        <button type="button" id="copy-email" class="chip">copy</button>
        <span id="copy-status" class="mono text-sm text-(--accent) opacity-0 transition-opacity">copied</span>
      </div>
    </div>

    <div class="mt-12 sm:mt-16 reveal brut p-6 sm:p-8">
      <h2 class="mono text-[10px] sm:text-xs uppercase tracking-[0.3em] text-(--muted)">Send a message</h2>

      <form id="contact-form" class="mt-6">
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="hidden" name="subject" value="New message from yaser.dev" />
        <input type="hidden" name="from_name" value="yaser.dev contact form" />
        <input
          type="checkbox"
          name="botcheck"
          class="hidden"
          style="display:none"
          tabindex="-1"
          autocomplete="off"
        />

        <div class="grid gap-5 stagger">
          <div>
            <label for="field-name" class="mono block text-[10px] uppercase tracking-[0.3em] text-(--muted) mb-2">
              Name
            </label>
            <input
              type="text"
              id="field-name"
              name="name"
              required
              maxlength="80"
              autocomplete="name"
              placeholder="your name"
              class="field"
            />
          </div>

          <div>
            <label for="field-email" class="mono block text-[10px] uppercase tracking-[0.3em] text-(--muted) mb-2">
              Email
            </label>
            <input
              type="email"
              id="field-email"
              name="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
              class="field"
            />
          </div>

          <div>
            <label for="field-message" class="mono block text-[10px] uppercase tracking-[0.3em] text-(--muted) mb-2">
              Message
            </label>
            <textarea
              id="field-message"
              name="message"
              required
              maxlength="2000"
              placeholder="what's on your mind?"
              class="field"></textarea>
          </div>

          <div class="flex flex-wrap items-center gap-4">
            <button type="submit" id="form-submit" class="btn btn-primary magnet" data-magnet="0.2">
              send message →
            </button>
            <p id="form-status" role="status" aria-live="polite" class="mono text-sm text-(--muted)"></p>
          </div>
        </div>
      </form>
    </div>

    <div class="mt-12 sm:mt-16 brut p-6 sm:p-8">
      <h2 class="mono text-[10px] sm:text-xs uppercase tracking-[0.3em] text-(--muted) mb-4 reveal">Elsewhere</h2>
      <ul class="grid grid-cols-2 sm:flex sm:flex-wrap gap-x-6 gap-y-3 stagger">
        {site.socials.map((s) => (
          <li><a href={s.href} class="link text-base sm:text-lg inline-block py-1" rel="me">{s.label.toLowerCase()} ↗</a></li>
        ))}
      </ul>
    </div>
  </section>

  <script define:vars={{ email: site.author.email, accessKey }}>
    function setupCopy() {
      const btn = document.getElementById('copy-email');
      const status = document.getElementById('copy-status');
      btn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(email);
          if (status) {
            status.style.opacity = '1';
            setTimeout(() => (status.style.opacity = '0'), 1500);
          }
        } catch {}
      });
    }

    function setupForm() {
      const form = document.getElementById('contact-form');
      const btn = document.getElementById('form-submit');
      const status = document.getElementById('form-status');
      if (!form || !btn || !status) return;

      if (!accessKey) {
        form.querySelectorAll('input, textarea, button').forEach((el) => (el.disabled = true));
        status.textContent = `form not configured — email me at ${email}`;
        status.className = 'mono text-sm text-(--accent)';
        return;
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const label = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'sending…';
        status.textContent = 'sending…';
        status.className = 'mono text-sm text-(--muted)';

        try {
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(Object.fromEntries(new FormData(form))),
          });
          const data = await res.json();
          if (!res.ok || !data.success) throw new Error(data.message || 'failed');

          form.reset();
          status.textContent = "message sent. i'll reply soon.";
          status.className = 'mono text-sm text-(--accent)';
        } catch {
          status.textContent = `couldn't send — email me at ${email}`;
          status.className = 'mono text-sm text-(--accent)';
        } finally {
          btn.disabled = false;
          btn.textContent = label;
        }
      });
    }

    setupCopy();
    setupForm();
    document.addEventListener('astro:after-swap', () => {
      setupCopy();
      setupForm();
    });
  </script>
</BaseLayout>
