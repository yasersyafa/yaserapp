---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
---

<BaseLayout title="Contact" description="Get in touch." current="Contact">
  <section class="max-w-3xl mx-auto px-5 sm:px-6 pt-16 sm:pt-20 pb-16">
    <p class="mono text-[10px] sm:text-xs uppercase tracking-[0.3em] text-(--muted) reveal">Say hi</p>
    <h1 class="display text-5xl sm:text-7xl mt-4 reveal" transition:name="page-title">Contact</h1>
    <p class="text-lg sm:text-xl mt-5 sm:mt-6 max-w-2xl text-(--muted) reveal">
      Open to: collab on indie projects · contract gigs · jams.
    </p>

    <div class="mt-10 sm:mt-12 reveal brut p-6 sm:p-8 bg-linear-to-br from-(--accent)/15 to-transparent">
      <p class="mono text-[10px] uppercase tracking-[0.3em] text-(--muted) mb-3">Email</p>
      <a
        href={`mailto:${site.author.email}`}
        class="display text-[clamp(0.95rem,4.6vw,2rem)] link inline-block magnet whitespace-nowrap"
        data-magnet="0.15"
      >
        {site.author.email}
      </a>
      <div class="mt-4 flex items-center gap-3">
        <button type="button" id="copy-email" class="chip">copy</button>
        <span id="copy-status" class="mono text-sm text-(--accent) opacity-0 transition-opacity">copied</span>
      </div>
    </div>

    <div class="mt-10 reveal">
      <a href="/resume.pdf" class="btn btn-primary magnet" data-magnet="0.2">↓ download resume</a>
    </div>

    <div class="mt-12 sm:mt-16 brut p-6 sm:p-8">
      <h2 class="mono text-[10px] sm:text-xs uppercase tracking-[0.3em] text-(--muted) mb-4 reveal">Elsewhere</h2>
      <ul class="grid grid-cols-2 sm:flex sm:flex-wrap gap-x-6 gap-y-3 stagger">
        {site.socials.map((s) => (
          <li><a href={s.href} class="link text-base sm:text-lg inline-block py-1" rel="me">{s.label.toLowerCase()} ↗</a></li>
        ))}
      </ul>
    </div>
  </section>

  <script define:vars={{ email: site.author.email }}>
    function setupCopy() {
      const btn = document.getElementById('copy-email');
      const status = document.getElementById('copy-status');
      btn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(email);
          if (status) {
            status.style.opacity = '1';
            setTimeout(() => (status.style.opacity = '0'), 1500);
          }
        } catch {}
      });
    }
    setupCopy();
    document.addEventListener('astro:after-swap', setupCopy);
  </script>
</BaseLayout>
