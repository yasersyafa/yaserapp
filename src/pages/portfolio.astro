---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';

const order = [
  'chroma-krash',
  'hage-games',
  'damn-thats-my-kard',
  'click-and-shield',
  'samsul-recycle',
];

const all = await getCollection('project');
const selected = order
  .map((id) => all.find((p) => p.id === id))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const profile = {
  name: site.author.name,
  title: 'Game Developer & Software Engineer',
  location: site.author.location,
  email: site.author.email,
  links: site.socials,
};

const summary = `Final-year Game Technology student. I ship games and the systems that ship them — Unity, .NET, React, Astro. Awards across national jams and competitions; production work at HAGE Games porting and serving web games end-to-end.`;

const highlights = [
  '1st Place — 4C National Competition 2024 (Click And Shield)',
  '2nd Runner-Up — COMPFEST 16 IGI Game Jam (Samsul Recycle)',
  'Live product ownership — hagegames.com',
  'Architecture-first jams — Service Locator, Event Bus, FSM',
];

const stack = ['Unity', 'C#', 'Godot', '.NET', 'React', 'TypeScript', 'Astro', 'Tailwind', 'Docker', 'AWS'];

const slidesPerProject = (p: typeof selected[number]) => 2 + (p.data.screenshots.length > 0 ? 1 : 0);
const slidesTotal = 2 + selected.reduce((acc, p) => acc + slidesPerProject(p), 0) + 1;
---

<BaseLayout
  title="Portfolio"
  description={`Portfolio presentation of ${profile.name} — landscape 16:9 PDF.`}
  current="Portfolio"
>
  <section class="max-w-7xl mx-auto px-5 sm:px-6 pt-12 sm:pt-16 pb-6 print:p-0">
    <div class="flex flex-wrap gap-3 justify-end mb-8 print:hidden">
      <button
        type="button"
        id="pdf-download"
        class="btn btn-primary magnet"
        data-magnet="0.2"
        aria-label="Download portfolio as PDF"
      >
        download .pdf ↓
      </button>
      <a href="/contact/" class="btn magnet" data-magnet="0.2">contact</a>
    </div>

    <article id="portfolio-doc" class="print-doc space-y-6 sm:space-y-8">

      {/* COVER SLIDE — title + name only */}
      <section class="slide slide-cover reveal" data-slide-bg="cover">
        <div class="slide-frame">
          <div class="slide-inner h-full flex flex-col justify-center">
            <p class="mono slide-eyebrow">Portfolio · {new Date().getFullYear()}</p>
            <h1 class="display slide-h1 mt-4" transition:name="page-title">{profile.name}.</h1>
          </div>
        </div>
      </section>

      {/* ABOUT SLIDE — portrait + about + stack + socials + highlights */}
      <section class="slide slide-about reveal">
        <div class="slide-frame">
          <div class="slide-inner h-full grid grid-cols-1 md:grid-cols-[2fr_3fr_2fr] gap-6 sm:gap-8 items-stretch">
            <div class="flex flex-col gap-4 min-w-0">
              <figure class="slide-portrait brut overflow-hidden flex flex-col">
                <div class="aspect-square w-full bg-linear-to-br from-(--accent)/20 to-(--secondary)/10">
                  <img src="/sprites/profile.jpg" alt={`Portrait of ${profile.name}`} class="w-full h-full object-cover" loading="eager" />
                </div>
                <figcaption class="mono text-[10px] uppercase tracking-widest text-(--muted) p-2.5 border-t-2 border-(--fg) shrink-0">— {profile.name}</figcaption>
              </figure>

              <div class="brut p-4">
                <p class="slide-label">Contact</p>
                <dl class="mt-2 mono text-xs space-y-1.5">
                  <div class="flex gap-2">
                    <dt class="text-(--muted) shrink-0">Email</dt>
                    <dd class="break-all"><a href={`mailto:${profile.email}`} class="link">{profile.email}</a></dd>
                  </div>
                  <div class="flex gap-2">
                    <dt class="text-(--muted) shrink-0">Based</dt>
                    <dd>{profile.location}</dd>
                  </div>
                </dl>
              </div>
            </div>

            <div class="flex flex-col min-w-0">
              <p class="slide-label">About</p>
              <p class="display slide-h2 mt-3 leading-[1.05]">Build the game. Build the systems that ship it.</p>
              <p class="mt-4 text-base text-(--muted) leading-relaxed">{summary}</p>

              <div class="mt-5">
                <p class="slide-label">Stack</p>
                <ul class="mt-2 flex flex-wrap gap-1.5">
                  {stack.map((s) => <li class="chip">{s}</li>)}
                </ul>
              </div>

              <div class="mt-5">
                <p class="slide-label">Social</p>
                <ul class="mt-2 flex flex-wrap gap-2 mono text-xs">
                  {profile.links.map((l) => (
                    <li><a href={l.href} class="chip">{l.label} ↗</a></li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="brut p-5 bg-linear-to-br from-(--secondary)/15 to-transparent self-stretch">
              <p class="slide-label">Highlights</p>
              <ul class="mt-3 space-y-2.5">
                {highlights.map((h) => (
                  <li class="flex gap-2 items-start text-sm leading-snug">
                    <span class="mono text-(--accent) shrink-0">▸</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>

      {/* PROJECT SLIDES */}
      {selected.map((p, i) => (
        <div class="project-group">

          {/* SLIDE A — INTRO */}
          <section class="slide slide-project-intro reveal">
            <div class="slide-frame">
              <div class="slide-inner h-full grid grid-cols-1 md:grid-cols-[5fr_4fr] gap-6 sm:gap-8">
                <figure class="slide-hero brut overflow-hidden self-stretch">
                  <img src={p.data.hero} alt={p.data.heroAlt} class="w-full h-full object-cover" loading="lazy" />
                </figure>

                <div class="flex flex-col h-full min-w-0">
                  <div class="flex items-baseline gap-3">
                    <span class="display text-4xl sm:text-5xl text-(--accent) leading-none">{String(i + 1).padStart(2, '0')}</span>
                    <span class="mono text-[10px] uppercase tracking-widest text-(--muted)">
                      {p.data.type} · {p.data.year}{p.data.engine ? ` · ${p.data.engine}` : ''}{p.data.duration ? ` · ${p.data.duration}` : ''}
                    </span>
                  </div>
                  <h3 class="display slide-h2 leading-[1.05] mt-3">{p.data.title}</h3>
                  <p class="mono text-xs sm:text-sm text-(--muted) mt-2">Role · {p.data.role}</p>
                  <p class="mt-4 text-base sm:text-lg leading-snug text-pretty">{p.data.dek}</p>

                  {p.data.tags.length > 0 && (
                    <ul class="mt-4 flex flex-wrap gap-1.5">
                      {p.data.tags.slice(0, 6).map((t) => <li class="chip">{t}</li>)}
                    </ul>
                  )}

                  <div class="mt-auto pt-4 flex flex-wrap gap-2 mono text-xs">
                    {p.data.links.play && <a href={p.data.links.play} class="chip">play ↗</a>}
                    {p.data.links.itch && <a href={p.data.links.itch} class="chip">itch ↗</a>}
                    {p.data.links.source && <a href={p.data.links.source} class="chip">source ↗</a>}
                    <a href={`/projects/${p.id}/`} class="chip">case study →</a>
                  </div>
                </div>
              </div>
            </div>
          </section>

          {/* SLIDE B — STAR */}
          <section class="slide slide-project-star reveal">
            <div class="slide-frame">
              <div class="slide-inner h-full flex flex-col">
                <div class="flex items-baseline justify-between mb-4">
                  <p class="slide-label">{p.data.title} · STAR</p>
                  <span class="mono text-[10px] uppercase tracking-widest text-(--muted)">{String(i + 1).padStart(2, '0')} / {selected.length}</span>
                </div>
                <ol class="grid grid-cols-2 grid-rows-2 gap-3 sm:gap-4 flex-1 min-h-0">
                  {[
                    { label: 'Situation', step: p.data.star.situation, accent: 'var(--accent)' },
                    { label: 'Task', step: p.data.star.task, accent: 'var(--secondary)' },
                    { label: 'Action', step: p.data.star.action, accent: 'var(--accent)' },
                    { label: 'Result', step: p.data.star.result, accent: 'var(--secondary)' },
                  ].map((s) => (
                    <li class="brut p-4 sm:p-5 star-cell flex flex-col min-h-0">
                      <span class="display text-xl sm:text-2xl leading-none" style={`color: ${s.accent};`}>{s.label}</span>
                      <p class="mt-2.5 text-sm leading-snug text-pretty">{s.step.body}</p>
                      {s.step.points.length > 0 && (
                        <ul class="mt-2.5 space-y-1 list-disc list-outside ml-4 marker:text-(--accent) text-[12px] leading-snug text-(--muted)">
                          {s.step.points.slice(0, 3).map((pt) => <li>{pt}</li>)}
                        </ul>
                      )}
                    </li>
                  ))}
                </ol>

                {p.data.star.result.metrics.length > 0 && (
                  <dl class="mt-4 grid grid-cols-3 gap-3">
                    {p.data.star.result.metrics.slice(0, 3).map((m) => (
                      <div class="brut p-3">
                        <dt class="slide-label">{m.label}</dt>
                        <dd class="mt-1 text-sm">{m.value}</dd>
                      </div>
                    ))}
                  </dl>
                )}
              </div>
            </div>
          </section>

          {/* SLIDE C — GALLERY (only if screenshots) */}
          {p.data.screenshots.length > 0 && (
            <section class="slide slide-project-gallery reveal">
              <div class="slide-frame">
                <div class="slide-inner h-full flex flex-col">
                  <div class="flex items-baseline justify-between mb-4">
                    <p class="slide-label">{p.data.title} · gallery</p>
                    <span class="mono text-[10px] uppercase tracking-widest text-(--muted)">{String(i + 1).padStart(2, '0')} / {selected.length}</span>
                  </div>
                  <div class="grid grid-cols-3 gap-4 flex-1 min-h-0">
                    {p.data.screenshots.slice(0, 3).map((shot) => (
                      <figure class="brut overflow-hidden flex flex-col">
                        <div class="flex-1 min-h-0 bg-(--accent)/10">
                          <img src={shot.src} alt={shot.alt} class="w-full h-full object-cover" loading="lazy" />
                        </div>
                        {shot.alt && (
                          <figcaption class="mono text-[10px] uppercase tracking-widest text-(--muted) p-2 border-t-2 border-(--fg) shrink-0">{shot.alt}</figcaption>
                        )}
                      </figure>
                    ))}
                  </div>
                  {p.data.press.length > 0 && (
                    <div class="mt-4 brut p-3 bg-(--accent)/10">
                      <p class="slide-label">Press</p>
                      <ul class="mt-1 text-sm space-y-1">
                        {p.data.press.map((pr) => <li>{pr.label}</li>)}
                      </ul>
                    </div>
                  )}
                </div>
              </div>
            </section>
          )}
        </div>
      ))}

      {/* CLOSING SLIDE */}
      <section class="slide slide-closing reveal" data-slide-bg="cover">
        <div class="slide-frame">
          <div class="slide-inner h-full flex flex-col justify-center items-center text-center">
            <p class="slide-eyebrow">End of portfolio</p>
            <p class="display text-4xl sm:text-6xl mt-4 leading-[1.05] max-w-3xl">Want to build something?</p>
            <p class="mono text-base text-(--muted) mt-4">{profile.email} · {profile.location}</p>
            <div class="mt-8 flex flex-wrap gap-3 justify-center print:hidden">
              <a href="/contact/" class="btn btn-primary magnet" data-magnet="0.2">say hi →</a>
              <a href="/projects/" class="btn magnet" data-magnet="0.2">see all work</a>
            </div>
          </div>
        </div>
      </section>

    </article>
  </section>

  <script>
    function setupPdf() {
      const btn = document.getElementById('pdf-download');
      if (!btn) return;
      btn.addEventListener('click', () => window.print());
    }
    setupPdf();
    document.addEventListener('astro:after-swap', setupPdf);
  </script>

  <style is:global>
    /* SCREEN: each slide presents as a tall brut card mimicking 16:9 board */
    .slide {
      border: 2px solid var(--fg);
      background: var(--bg);
      box-shadow: 4px 4px 0 0 var(--fg);
    }
    .slide-frame {
      aspect-ratio: 16 / 9;
      padding: clamp(1.25rem, 3vw, 2.5rem);
      display: flex;
    }
    .slide-inner { width: 100%; }
    .slide[data-slide-bg="cover"] {
      background: linear-gradient(to bottom right, color-mix(in oklab, var(--accent) 18%, transparent), transparent);
    }
    .slide-eyebrow {
      font-family: var(--font-mono);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.3em;
      color: var(--muted);
    }
    .slide-label {
      font-family: var(--font-mono);
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--muted);
    }
    .slide-h1 { font-size: clamp(2.5rem, 7vw, 5.5rem); line-height: 0.95; }
    .slide-h2 { font-size: clamp(2rem, 4.5vw, 3.5rem); }
    .slide-sub { font-size: clamp(0.95rem, 1.6vw, 1.25rem); }
    .slide-hero {
      box-shadow: 4px 4px 0 0 var(--fg);
      min-height: 0;
      display: block;
      background: var(--accent);
    }
    .slide-hero img {
      display: block;
      aspect-ratio: 16 / 10;
    }

    @media (max-width: 640px) {
      .slide-frame { aspect-ratio: auto; padding: 1.25rem; }
    }

    @media print {
      @page {
        size: 13.333in 7.5in;
        margin: 0;
      }

      :root, :root[data-theme="dark"] {
        --bg: #ffffff !important;
        --fg: #0a0a0a !important;
        --muted: #4b4b50 !important;
        --line: rgba(10, 10, 10, 0.18) !important;
        --shadow: #0a0a0a !important;
      }

      html, body {
        background: #ffffff !important;
        color: #0a0a0a !important;
        cursor: auto !important;
        margin: 0 !important;
        padding: 0 !important;
        print-color-adjust: exact !important;
        -webkit-print-color-adjust: exact !important;
      }

      *, *::before, *::after {
        print-color-adjust: exact !important;
        -webkit-print-color-adjust: exact !important;
      }

      header.sticky,
      footer,
      #nav-toggle,
      #nav-panel,
      #cursor-dot,
      #cursor-ring,
      #cursor-label,
      .cursor-trail-dot,
      .print\:hidden {
        display: none !important;
      }

      main { padding: 0 !important; margin: 0 !important; }

      .reveal, .stagger > * {
        opacity: 1 !important;
        transform: none !important;
      }

      a { color: #0a0a0a !important; text-decoration: none !important; }
      .display { color: #0a0a0a !important; }

      .max-w-7xl, section.max-w-7xl {
        max-width: none !important;
        padding: 0 !important;
        margin: 0 !important;
      }

      .print-doc {
        margin: 0 !important;
        padding: 0 !important;
        gap: 0 !important;
      }
      .print-doc > * + * { margin-top: 0 !important; }

      .project-group { display: contents; }

      .slide {
        width: 13.333in !important;
        height: 7.5in !important;
        max-width: none !important;
        max-height: 7.5in !important;
        overflow: hidden !important;
        margin: 0 !important;
        border: 0 !important;
        box-shadow: none !important;
        background: #ffffff !important;
        page-break-after: always;
        break-after: page;
        page-break-inside: avoid;
        break-inside: avoid;
        display: block !important;
      }

      .slide:last-of-type {
        page-break-after: auto;
        break-after: auto;
      }

      .slide[data-slide-bg="cover"] {
        background: linear-gradient(to bottom right, rgba(255, 180, 84, 0.18), #ffffff) !important;
      }

      .slide-frame {
        width: 13.333in !important;
        height: 7.5in !important;
        aspect-ratio: auto !important;
        padding: 0.45in 0.55in !important;
        box-sizing: border-box !important;
        display: flex !important;
      }

      .slide-inner {
        width: 100% !important;
        height: 100% !important;
      }

      .slide-h1 { font-size: 64pt !important; line-height: 0.95 !important; }
      .slide-h2 { font-size: 36pt !important; line-height: 1.05 !important; }
      .slide-sub { font-size: 13pt !important; }
      .slide-eyebrow { font-size: 9pt !important; }
      .slide-label { font-size: 8pt !important; }

      .slide p { font-size: 11pt; line-height: 1.4; }
      .slide .text-sm,
      .slide .text-xs { font-size: 10pt !important; }
      .slide .text-base { font-size: 11pt !important; }
      .slide .text-lg { font-size: 12pt !important; }

      .slide .brut {
        box-shadow: 2px 2px 0 0 #0a0a0a !important;
        border: 2px solid #0a0a0a !important;
        background: #ffffff !important;
      }

      .slide .chip {
        box-shadow: 1px 1px 0 0 #0a0a0a !important;
        border: 2px solid #0a0a0a !important;
        background: #ffffff !important;
        padding: 1pt 5pt !important;
        font-size: 7.5pt !important;
      }

      .slide-hero {
        box-shadow: 3px 3px 0 0 #0a0a0a !important;
        background: rgba(255, 180, 84, 0.25) !important;
      }
      .slide-hero img {
        aspect-ratio: auto !important;
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
      }

      .slide-portrait {
        box-shadow: 3px 3px 0 0 #0a0a0a !important;
        border: 2px solid #0a0a0a !important;
        background: #ffffff !important;
        page-break-inside: avoid;
        break-inside: avoid;
        align-self: flex-start !important;
      }
      .slide-portrait > div {
        aspect-ratio: 1 / 1 !important;
        width: 100% !important;
        height: auto !important;
      }
      .slide-portrait img {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
      }

      .star-cell {
        background: #ffffff !important;
        page-break-inside: avoid;
        break-inside: avoid;
        overflow: hidden;
      }
      .star-cell .display {
        font-size: 14pt !important;
      }
      .star-cell p { font-size: 10pt !important; line-height: 1.35 !important; }
      .star-cell ul { font-size: 9pt !important; line-height: 1.3 !important; }
    }
  </style>
</BaseLayout>
